{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local image prompt writer output",
  "description": "One compiled prompt, or an explicitly requested batch. This is not an image-model request schema or a native LM Studio preset.",
  "$defs": {
    "compiled_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_model",
        "positive_prompt",
        "negative_prompt",
        "parameters",
        "notes"
      ],
      "properties": {
        "target_model": {
          "type": "string",
          "enum": [
            "Qwen-Image-Edit-2511",
            "FLUX.2-klein-4B",
            "FLUX.2-klein-9B",
            "Anima",
            "IllustriousXL"
          ]
        },
        "positive_prompt": {
          "type": "string"
        },
        "negative_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/compiled_prompt"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compiled_prompt"
      }
    }
  ]
}
